{
  "name": "@tedberg/constraint-modeler",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "author": {
    "name": "Ted Bergeron"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true,force:true}); fs.rmSync('target', {recursive:true,force:true})\"",
    "lint": "oxlint src && eslint src",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:pw": "playwright test",
    "test:e2e:pw:ui": "playwright test --ui"
  },
  "main": "dist/constraint-modeler.umd.js",
  "exports": {
    ".": {
      "import": "./dist/constraint-modeler.common.js",
      "require": "./dist/constraint-modeler.umd.js"
    },
    "./dist/constraint-modeler.css": "./dist/constraint-modeler.css"
  },
  "unpkg": "dist/constraint-modeler.umd.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-vue-next": "^0.45.0",
    "mitt": "^3.0.1",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.7.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-oxlint": "^1.68.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-vue-next": "^0.45.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "bugs": {
    "url": "https://github.com/tedberg/constraint-modeler/issues"
  },
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=11.8.0"
  },
  "gitHooksX": {
    "pre-commit": "foo"
  },
  "homepage": "https://github.com/tedberg/constraint-modeler#readme",
