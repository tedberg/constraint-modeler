{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(javac:*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(mvn *)",
      "Bash(source:*)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose ps *)",
      "Bash(docker-compose logs *)",
      "Bash(git add:*)",
      "Bash(jar tf:*)",
      "Bash(ls:*)",
      "Bash(done)",
      "mcp__jetbrains",
      "WebFetch(domain:bitbucket.org)",
      "WebFetch(domain:www.jetbrains.com)",
      "WebFetch(domain:javadoc.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:central.sonatype.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(docker-compose down -v *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -q 'git commit'; then untracked=$(git -C \"$CLAUDE_PROJECT_DIR\" status --short 2>/dev/null | grep '^??' || true); if [ -n \"$untracked\" ]; then printf '{\"systemMessage\": \"WARNING: Untracked files before commit — consider git add:\\n%s\"}\\n' \"$untracked\"; fi; fi",
            "statusMessage": "Checking for untracked files..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-mvn-test-format.sh",
            "statusMessage": "Applying Spotless before Maven test phase..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-pom-format.sh"
          }
        ]
      }
    ]
  }
}
