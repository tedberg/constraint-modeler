{
  "name": "@tedberg/constraint-modeler",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "author": {
    "name": "Ted Bergeron"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true,force:true}); fs.rmSync('target', {recursive:true,force:true})\"",
    "lint": "oxlint src && eslint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "publish:local": "npm run build:lib && yalc push"
  },
  "main": "dist/constraint-modeler.umd.js",
  "exports": {
    ".": {
      "import": "./dist/constraint-modeler.common.js",
      "require": "./dist/constraint-modeler.umd.js"
    },
    "./dist/constraint-modeler.css": "./dist/constraint-modeler.css"
  },
  "unpkg": "dist/constraint-modeler.umd.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "mitt": "^3.0.1",
    "reka-ui": "^2.9.9",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-oxlint": "^1.68.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/tedberg/constraint-modeler/issues"
  },
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=11.8.0"
  },
  "gitHooksX": {
    "pre-commit": "foo"
  },
  "homepage": "https://github.com/tedberg/constraint-modeler#readme",
  "keywords": [],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedberg/constraint-modeler.git"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
